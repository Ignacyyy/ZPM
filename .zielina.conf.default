
# ─────────────────────────────────────────────────────────────────────────────
# ZPM Configuration File
# Location: /opt/ZPM/zielina.conf
# ─────────────────────────────────────────────────────────────────────────────

[core]
# Show update notifications in ZPM tools
# true  = show notifications when a new ZPM version is available
# false = silent mode, no update prompts
update-info=true

[UI-zhelp]
# ── Default page ──────────────────────────────────────────────────────────────
# Controls which page is shown when running "zhelp" with no arguments.
# RULES:
#   - Exactly ONE of the zhelp-default-page-N options must be set to true
#   - All others must be false
#   - If zhelp-show-all-pages=true, both below must be false
#
# PAGE 1 — ARM support and config information
zhelp-default-page-1=true
# PAGE 2 — Commands, options and zpm wrapper info
zhelp-default-page-2=false

# ── Show all pages ────────────────────────────────────────────────────────────
# Displays all pages at once when running "zhelp"
# If set to true, zhelp-default-page-1 and zhelp-default-page-2 MUST be false
zhelp-show-all-pages=false
